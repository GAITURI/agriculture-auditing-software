{
  "name": "scipec-operations-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "build": "npm run vendor && npm run build:css && node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --src"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  }
}
